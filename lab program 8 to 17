        "import pandas as pd\n",
        "\n",
        "# Create sales data\n",
        "data = {\n",
        "    'Product': ['Laptop', 'Mobile', 'Laptop', 'Tablet',\n",
        "                'Mobile', 'Headphone', 'Tablet', 'Mobile',\n",
        "                'Laptop', 'Headphone'],\n",
        "    'Quantity': [10, 20, 15, 8, 25, 12, 10, 15, 20, 18]\n",
        "}\n",
        "\n",
        "# Create DataFrame\n",
        "df = pd.DataFrame(data)\n",
        "\n",
        "# Calculate total sales of each product\n",
        "sales = df.groupby('Product')['Quantity'].sum()\n",
        "\n",
        "# Find top 5 products\n",
        "top5 = sales.sort_values(ascending=False).head(5)\n",
        "\n",
        "# Display result\n",
        "print(\"Top 5 Best-Selling Products:\")\n",
        "print(top5)"
